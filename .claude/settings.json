{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node scripts/verify.mjs:*)",
      "Bash(node scripts/ui-check.mjs:*)",
      "Bash(node scripts/setup.mjs:*)",
      "Bash(node scripts/codex-review.mjs:*)",
      "Bash(node scripts/stamp.mjs:*)",
      "Bash(node scripts/next-migration.mjs:*)",
      "Bash(node scripts/check-migrations.mjs:*)",
      "Bash(node scripts/pr-screens.mjs:*)",
      "Bash(node scripts/token-report.mjs:*)",
      "Bash(node --test \"scripts/test/*.test.mjs\")",
      "Bash(./gradlew:*)",
      "Bash(gradlew.bat:*)",
      "Bash(npm run:*)",
      "Bash(npx prettier:*)",
      "Bash(npx playwright:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git push -u origin feature/:*)",
      "Bash(git push origin feature/:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git merge origin/develop:*)",
      "Bash(git mv:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(node scripts/owners.mjs:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(node scripts/doctor.mjs:*)",
      "Bash(node scripts/weekly.mjs:*)",
      "Bash(node scripts/branches.mjs:*)",
      "Bash(node --check:*)",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(file:*)",
      "Bash(date:*)",
      "Bash(diff:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-tree:*)",
      "Bash(git ls-remote:*)",
      "Bash(git cat-file:*)",
      "Bash(git merge-base:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git check-ignore:*)",
      "Bash(git remote -v)",
      "Bash(git remote get-url:*)",
      "Bash(git config --get:*)",
      "Bash(git stash list:*)",
      "Bash(git worktree list:*)",
      "Bash(git blame:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh pr diff:*)",
      "Bash(docker info:*)",
      "Bash(docker ps:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*.local)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*desktop-commander__(start_process|interact_with_process)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob|mcp__.*desktop-commander__(write_file|edit_block|move_file|read_file|read_multiple_files|start_search|list_directory|get_file_info)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-files.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/area-notice.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/peer-watch.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/checkpoint-nudge.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/codex-loop.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
