# 두 PC(Windows) 간 줄바꿈 차이로 diff가 오염되지 않도록 정규화
* text=auto

# 셸에서 실행되는 파일은 반드시 LF (CRLF면 Git Bash/hook 실행 실패)
*.sh        text eol=lf
gradlew     text eol=lf
.githooks/* text eol=lf
*.mjs       text eol=lf

# Windows 배치 파일은 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 바이너리
*.png binary
*.jpg binary
*.zip binary
*.jar binary
