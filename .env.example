# 바이브노트 환경변수 예시. 이 파일을 저장소 밖 ~/.vibenote/.env로 복사해 값을 채운다 (PC마다, 커밋하지 않는다).
# 비밀을 AI가 검색하는 저장소 폴더에 두지 않으려는 것이다 (#249). 백엔드는 실행 시 이 파일을 자동으로 읽는다 (application.yml의 spring.config.import).
# 예전처럼 저장소 루트에 .env가 있으면 옮기는 동안 함께 읽는다 (둘 다 있으면 ~/.vibenote가 이긴다). 옮기기: node scripts/setup.mjs --move-env

# MySQL (local 프로필 기본값: localhost:3306/vibenote)
DB_URL=jdbc:mysql://localhost:3306/vibenote?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=vibenote
DB_PASSWORD=

# JWT 서명 키 (32바이트 이상 임의 문자열). local 프로필은 이 줄이 없으면 개발용 키를 쓴다
# (빈 값으로 두면 빈 키가 되어 실행에 실패하므로, 쓰지 않을 때는 주석으로 둔다)
# JWT_SECRET=

# LLM: mock(기본) | gms | ollama | gemini. gms는 실패하면 Ollama(간이 모드)로 폴백한다. gemini는 평가 비교용(폴백 없음)
LLM_PROVIDER=mock
# provider=gms면 필수 (비어 있으면 기동 실패). SSAFY GMS에서 팀별로 발급한 키. 잔여 크레딧: GET https://gms.ssafy.io/gmsapi/key-info
GMS_API_KEY=
# GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
# 쓰지 않으면 줄째로 주석 처리한다 (GMS_MODEL= 처럼 빈 값을 두면 기본값이 아니라 빈 문자열이 되어 기동 실패)
# GMS_MODEL=gpt-4.1-mini
# provider=gemini면 필수 (비어 있으면 기동 실패). https://aistudio.google.com 에서 발급
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Ollama(gms 폴백·ollama)는 0.5 이상 필요 (단계별 JSON 스키마를 format으로 보낸다)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# 공개 저장소 URL 분석(F-05b)용 GitHub 토큰. 선택: 없으면 비인증 한도(IP당 60회/시)를 쓴다.
# 교육장처럼 여러 명이 같은 공인 IP를 쓰면 한도가 금방 차므로 넣어 두면 5,000회/시가 된다. 공개 저장소 읽기 권한이면 충분하다
GITHUB_TOKEN=

# 로컬 관리자 계정 (F-00b). 먼저 이 이메일로 가입한 뒤 넣고 BE를 다시 띄우면 그 회원이 ADMIN이 된다 (local 프로필)
ADMIN_BOOTSTRAP_EMAIL=
