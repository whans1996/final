<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- A(F-08)와 B(F-09~13)가 함께 쓴다. 자기 블록 안에만 추가한다 (ConceptMapper.java와 같은 블록) -->
<mapper namespace="com.vibenote.concept.ConceptMapper">

    <!-- ── 공통 조회 ── -->

    <sql id="columns">
        id, name, category, difficulty, summary, body, example_code, status, source, reference_url,
        wish_count, avg_rating, created_at, updated_at
    </sql>

    <sql id="summaryColumns">id, name, category, difficulty, summary, wish_count, avg_rating</sql>

    <select id="findById" resultType="com.vibenote.concept.domain.Concept">
        SELECT <include refid="columns"/> FROM concepts WHERE id = #{id}
    </select>

    <select id="findPublishedByIds" resultType="com.vibenote.concept.domain.Concept">
        SELECT <include refid="summaryColumns"/>
        FROM concepts
        WHERE status = 'PUBLISHED'
          AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>

    <!-- ── F-08 개념 추출 (A) ── -->

    <!-- ── F-09~13 카드 (B) ── -->

    <!-- F-09 목록 조건. keyword는 Service가 ! 로 이스케이프한 값. 대소문자 무시는 collation(utf8mb4_0900_ai_ci)에 맡긴다 -->
    <sql id="publishedSearchWhere">
        WHERE status = 'PUBLISHED'
        <if test="category != null">AND category = #{category}</if>
        <if test="difficulty != null">AND difficulty = #{difficulty}</if>
        <if test="keyword != null">
            AND (name LIKE CONCAT('%', #{keyword}, '%') ESCAPE '!'
                 OR summary LIKE CONCAT('%', #{keyword}, '%') ESCAPE '!')
        </if>
    </sql>

    <select id="findPublished" resultType="com.vibenote.concept.domain.Concept">
        SELECT <include refid="summaryColumns"/>
        FROM concepts
        <include refid="publishedSearchWhere"/>
        <choose>
            <when test="sort.name() == 'LATEST'">ORDER BY created_at DESC, id DESC</when>
            <otherwise>ORDER BY wish_count DESC, avg_rating DESC, id ASC</otherwise>
        </choose>
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countPublished" resultType="long">
        SELECT COUNT(*) FROM concepts
        <include refid="publishedSearchWhere"/>
    </select>

</mapper>
