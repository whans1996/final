<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vibenote.auth.RefreshTokenMapper">

    <insert id="insert">
        INSERT INTO refresh_tokens (user_id, token_hash, expires_at)
        VALUES (#{userId}, #{tokenHash}, NOW() + INTERVAL #{validitySeconds} SECOND)
    </insert>

    <resultMap id="stored" type="com.vibenote.auth.RefreshTokenMapper$StoredRefreshToken">
        <constructor>
            <arg column="id" javaType="_long"/>
            <arg column="user_id" javaType="_long"/>
            <arg column="expired" javaType="_boolean"/>
        </constructor>
    </resultMap>

    <select id="findByHash" resultMap="stored">
        SELECT id, user_id, expires_at &lt;= NOW() AS expired
        FROM refresh_tokens
        WHERE token_hash = #{tokenHash}
    </select>

    <delete id="deleteByHash">
        DELETE FROM refresh_tokens WHERE token_hash = #{tokenHash}
    </delete>
</mapper>
