{
  "name": "vibenote-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "lint": "node scripts/run-oxlint.mjs . --fix && eslint . --fix --cache && prettier --write src/",
    "lint:check": "node scripts/run-oxlint.mjs . && eslint . && prettier --check src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.94.0",
    "eslint-plugin-vue": "~10.12.1",
    "globals": "^17.12.0",
    "jsdom": "^31.0.1",
    "oxlint": "~1.94.0",
    "playwright": "^1.65.1",
    "prettier": "3.10.1",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
}
